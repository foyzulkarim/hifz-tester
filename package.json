{
  "name": "hifz-tester",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:3010": "PORT=3010 next dev",
    "build": "next build",
    "start": "next start",
    "start:3010": "PORT=3010 next start",
    "lint": "next lint",
    "test": "tsx tests/core.test.ts",
    "typecheck": "tsc --noEmit",
    "service:start": "launchctl load ~/Library/LaunchAgents/com.foyzul.hifz-tester.plist",
    "service:stop": "launchctl unload ~/Library/LaunchAgents/com.foyzul.hifz-tester.plist",
    "service:restart": "npm run service:stop && npm run build && npm run service:start",
    "logs": "tail -f /Users/foyzul/personal/hafiz-ai/hifz-tester/server.log"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.3.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
