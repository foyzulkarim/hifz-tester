{
  "name": "hifz-tester",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,asr -c green,cyan \"next dev\" \"uvicorn scripts.asr_fastapi:app --host 127.0.0.1 --port 8766 --reload\"",
    "asr:start": "uvicorn scripts.asr_fastapi:app --host 127.0.0.1 --port 8765",
    "build": "next build",
    "start": "concurrently -n next,asr -c green,cyan \"next start\" \"uvicorn scripts.asr_fastapi:app --host 127.0.0.1 --port 8765\"",    
    "lint": "next lint",
    "test": "tsx tests/core.test.ts && tsx tests/asr-fastapi.test.ts",
    "test:core": "tsx tests/core.test.ts",
    "test:asr": "tsx tests/asr-fastapi.test.ts",
    "typecheck": "tsc --noEmit",
    "service:start": "launchctl load ~/Library/LaunchAgents/com.foyzul.hifz-tester.plist",
    "service:stop": "launchctl unload ~/Library/LaunchAgents/com.foyzul.hifz-tester.plist",
    "service:restart": "npm run service:stop && npm run build && npm run service:start",
    "logs": "tail -f server.log"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.60.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
